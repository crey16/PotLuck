{
  "name": "potluck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test lib/poker/*.test.ts lib/drill/*.test.ts lib/drill/kinds/*.test.ts lib/play/*.test.ts lib/supabase/*.test.ts lib/learn/*.test.ts components/ui/*.test.ts components/drill/*.test.ts components/learn/*.test.ts",
    "api": "uvicorn api.index:app --port ${API_PORT:-8000} --reload --env-file .env.local",
    "api:bare": "uvicorn api.index:app --port ${API_PORT:-8000} --reload",
    "dev:all": "concurrently \"npm:dev\" \"npm:api\"",
    "dev:all:bare": "concurrently \"npm:dev\" \"npm:api:bare\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5"
  }
}
